# Copy to .env and fill in the secrets. Local defaults shown below;
# see the "CLOUD / FREE DEPLOY" block at the bottom for hosting on Render + Neon.

# --- PostgreSQL (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tender_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# Cloud databases (Neon/Supabase) need SSL — set to: require
POSTGRES_SSLMODE=

# --- Ollama (local) — embeddings + chat fallback when no cloud keys are set ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# --- Groq (cloud, free tier) — chat. Set a free key to use it (fast + accurate).
# Get one at https://console.groq.com  (leave blank to use local Ollama for chat)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (cloud, free tier) — embeddings. Set a free key to use Gemini
# instead of local Ollama (required on free hosts that can't run Ollama).
# Get one at https://aistudio.google.com/apikey  (leave blank to use local Ollama)
GOOGLE_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- RAG params ---
CHUNK_TOKENS=500
CHUNK_OVERLAP=80
TOP_K=4

# On-demand scraping needs local binaries (Playwright/Tesseract/LibreOffice).
# true locally; set false on cloud hosts -> query-only over pre-loaded tenders.
ENABLE_SCRAPING=true
# Where the scrapers write their output (each source has <source>/output/).
SCRAPERS_ROOT=c:/anshul/MVP

# ------------------------------------------------------------------------------
# CLOUD / FREE DEPLOY (Render + Neon + Gemini + Groq) — set these on the host:
#   POSTGRES_HOST=<your-neon-host>.neon.tech
#   POSTGRES_DB=<neon-db>          POSTGRES_USER=<neon-user>
#   POSTGRES_PASSWORD=<neon-password>   POSTGRES_SSLMODE=require
#   GOOGLE_API_KEY=<gemini key>    GROQ_API_KEY=<groq key>
#   ENABLE_SCRAPING=false
# See DEPLOY.md for the full step-by-step.
# ------------------------------------------------------------------------------
