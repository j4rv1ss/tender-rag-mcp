# Copy to .env and fill in the secrets. Local defaults shown below;
# see the "SHARED / CLOUD DATABASE" block at the bottom for pointing at Neon.
#
# The MCP server reads this file from the project folder, so a client must launch
# it with cwd set here. Real environment variables (e.g. an MCP client's "env"
# block) override anything set below.

# --- PostgreSQL (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tender_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# Cloud databases (Neon/Supabase) need SSL — set to: require
POSTGRES_SSLMODE=

# --- Embeddings provider: fastembed | ollama | gemini ---
# fastembed = in-process ONNX (bge-small, 384-dim). Free, no API, no quotas.
#             Recommended for cloud/free hosting. (dim is fixed by the provider.)
# ollama    = local nomic-embed-text (768-dim); the local-dev default.
# gemini    = Google cloud API (768-dim); has a hard free-tier daily cap.
EMBED_PROVIDER=ollama

# --- Ollama (local) — embeddings (when EMBED_PROVIDER=ollama) + OPTIONAL offline
# chat fallback. Leave CHAT_MODEL blank (llama3.2 removed) to chat via Llama 4;
# set it (e.g. llama3.1:8b) only if you want a local offline fallback. ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=
EMBED_MODEL=nomic-embed-text

# --- Chat: Llama 4 via any OpenAI-compatible host, PRIMARY, via LangChain.
# Default = OpenRouter (free key at https://openrouter.ai → Keys).
# (Swap LLAMA_API_URL/MODEL for Meta api.llama.com, Cerebras, etc. if you prefer.)
LLAMA_API_KEY=
LLAMA_API_URL=https://openrouter.ai/api/v1
LLAMA_MODEL=meta-llama/llama-4-maverick
LLAMA_FALLBACK_MODELS=meta-llama/llama-4-scout

# --- Groq (optional) — cross-provider BACKUP using non-Llama gpt-oss models, so
# chat still answers if the Llama API is rate-limited. Free key at console.groq.com
GROQ_API_KEY=

# --- Google Gemini (optional, only if EMBED_PROVIDER=gemini) ---
GOOGLE_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- MCP transport ---
# stdio (the default) needs none of this. Only set these to serve the HTTP
# transport: `python -m app.mcp_server --http`.
# MCP_AUTH_TOKEN is REQUIRED in HTTP mode — the server refuses to start without
# it rather than exposing the corpus. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# Host headers to accept (DNS-rebinding protection); comma-separated. Leave blank
# for localhost. Render's hostname is trusted automatically.
MCP_ALLOWED_HOSTS=

# --- RAG params ---
CHUNK_TOKENS=500
CHUNK_OVERLAP=80
TOP_K=4

# On-demand scraping needs local binaries (Playwright/Tesseract/LibreOffice).
# true locally; set false on cloud hosts -> query-only over pre-loaded tenders.
ENABLE_SCRAPING=true
# Where the scrapers write their output (each source has <source>/output/).
SCRAPERS_ROOT=c:/anshul/MVP

# ------------------------------------------------------------------------------
# SHARED / CLOUD DATABASE (Neon + fastembed + Llama 4) — the MCP server itself runs
# locally (stdio has no host), but several machines can share one corpus:
#   POSTGRES_HOST=<your-neon-host>.neon.tech   POSTGRES_DB=<neon-db>
#   POSTGRES_USER=<neon-user>   POSTGRES_PASSWORD=<neon-password>
#   POSTGRES_SSLMODE=require
#   EMBED_PROVIDER=fastembed    (embeddings run in-process — no key needed)
#   LLAMA_API_KEY=<llama api key>   (GROQ_API_KEY optional backup)
#   ENABLE_SCRAPING=false       on machines without the scraper binaries
# See DEPLOY.md for the full step-by-step.
# ------------------------------------------------------------------------------
